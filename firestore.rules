rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(trip) { return request.auth != null && request.auth.token.trip == trip; }
  function teacher(trip) { return signed(trip) && request.auth.token.teacher == true; }
  function ownProfile(trip) { return get(/databases/$(database)/documents/trips/$(trip)/students/$(request.auth.uid)).data; }
  function member(trip) { return signed(trip) && (teacher(trip) || ownProfile(trip).active == true); }
  function student(trip, uid) { return member(trip) && request.auth.uid == uid && request.auth.token.teacher == false; }
  function mission(id) { return id in ['museum','fairplay','tower','upcycle','math','theater','color','aquarium','memory','sticker','photo1','photo2','photo3','photo4','photo5','photo6','photo7','photo8','photo9']; }
  function field(m,k) { return m.get(k,'') is string && m.get(k,'').size() <= 300; }
  function valid(d) {
   return d.keys().hasAll(['ownerUid','missionId','title','body','extraBody','fields','participants','url','photoClaim','review','feedback','public','album','updatedAt','windowStart','saveCount'])
   && d.keys().hasOnly(['ownerUid','missionId','title','body','extraBody','fields','participants','url','photoClaim','review','feedback','public','album','updatedAt','windowStart','saveCount'])
   && d.ownerUid is string && mission(d.missionId)
   && d.title is string && d.title.size() <= 100 && d.body is string && d.body.size() <= 2000 && d.extraBody is string && d.extraBody.size() <= 2000
   && d.fields is map && d.fields.size() <= 6 && d.fields.keys().hasOnly(['realName', 'newName', 'reason', 'meaning', 'moment', 'feeling', 'material', 'use', 'idea', 'discovery', 'scene', 'message', 'color', 'name', 'feature', 'production']) && field(d.fields, 'realName') && field(d.fields, 'newName') && field(d.fields, 'reason') && field(d.fields, 'meaning') && field(d.fields, 'moment') && field(d.fields, 'feeling') && field(d.fields, 'material') && field(d.fields, 'use') && field(d.fields, 'idea') && field(d.fields, 'discovery') && field(d.fields, 'scene') && field(d.fields, 'message') && field(d.fields, 'color') && field(d.fields, 'name') && field(d.fields, 'feature') && field(d.fields, 'production')
   && d.participants is list && d.participants.size() <= 20 && d.participants.hasAny([d.ownerUid])
   && d.url is string && d.url.size() <= 500 && (d.url == '' || d.url.matches('https://[^\\s]+')) && d.photoClaim is bool
   && d.review in ['pending','confirmed','revise'] && d.feedback is string && d.feedback.size() <= 500 && d.public is bool && d.album is bool
   && d.updatedAt is timestamp && d.windowStart is timestamp && d.saveCount is int && d.saveCount >= 1 && d.saveCount <= 30;
  }
  match /trips/{trip}/settings/main {
   allow read: if member(trip);
   allow write: if teacher(trip) && request.resource.data.keys().hasOnly(['notice','closed','uploads','schedules','colors','canva','meetings','aiLinks']) && request.resource.data.notice is string && request.resource.data.notice.size() <= 1000 && request.resource.data.closed is bool;
  }
  match /trips/{trip}/names/{name} {
   allow get: if member(trip);
   allow list: if false;
   allow create: if member(trip) && request.resource.data.keys().hasOnly(['uid','label']) && request.resource.data.label == name && name.matches('[가-힣a-zA-Z]{2,20}') && (teacher(trip) || (request.resource.data.uid == request.auth.uid && ownProfile(trip).get('nameConfirmed',false) == false && getAfter(/databases/$(database)/documents/trips/$(trip)/students/$(request.auth.uid)).data.label == name && getAfter(/databases/$(database)/documents/trips/$(trip)/students/$(request.auth.uid)).data.nameConfirmed == true));
   allow update: if teacher(trip) && request.resource.data.uid == resource.data.uid && request.resource.data.label == name;
   allow delete: if teacher(trip);
  }
  match /trips/{trip}/students/{uid} {
   allow get: if teacher(trip) || (signed(trip) && request.auth.uid == uid) || member(trip);
   allow list: if member(trip) && request.query.limit <= 20;
   allow create, delete: if false;
   allow update: if (teacher(trip) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label','group','active','nameConfirmed']) && request.resource.data.label is string && request.resource.data.label.size() <= 20 && request.resource.data.group is string && request.resource.data.group.size() <= 20 && request.resource.data.active is bool && request.resource.data.nameConfirmed is bool && getAfter(/databases/$(database)/documents/trips/$(trip)/names/$(request.resource.data.label)).data.uid == uid)
   || (student(trip,uid) && resource.data.get('nameConfirmed',false) == false && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label','nameConfirmed']) && request.resource.data.nameConfirmed == true && request.resource.data.label.matches('[가-힣a-zA-Z]{2,20}') && getAfter(/databases/$(database)/documents/trips/$(trip)/names/$(request.resource.data.label)).data.uid == uid);
  }
  match /trips/{trip}/entries/{entryId} {
   function readable() { return member(trip) && (teacher(trip) || resource.data.ownerUid == request.auth.uid || request.auth.uid in resource.data.participants || resource.data.public == true); }
   allow get: if readable() || (member(trip) && !exists(/databases/$(database)/documents/trips/$(trip)/entries/$(entryId)));
   allow list: if request.query.limit <= 400 && readable();
   function canSubmit() { let d=request.resource.data; return student(trip,d.ownerUid) && ownProfile(trip).nameConfirmed == true && entryId == d.ownerUid+'_'+d.missionId && get(/databases/$(database)/documents/trips/$(trip)/settings/main).data.closed == false && valid(d) && d.review == 'pending' && d.feedback == '' && d.public == false && d.album == false && d.updatedAt == request.time; }
   allow create: if canSubmit() && request.resource.data.saveCount == 1 && request.resource.data.windowStart == request.time;
   allow update: if (canSubmit() && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.missionId == resource.data.missionId && request.time >= resource.data.updatedAt + duration.value(60,'s') && ((request.time >= resource.data.windowStart + duration.value(24,'h') && request.resource.data.windowStart == request.time && request.resource.data.saveCount == 1) || (request.time < resource.data.windowStart + duration.value(24,'h') && request.resource.data.windowStart == resource.data.windowStart && request.resource.data.saveCount == resource.data.saveCount + 1)))
   || (teacher(trip) && valid(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review','feedback','public','album']));
   allow delete: if teacher(trip);
  }
 }
}
